# Copia este archivo a ".env" (cp .env.example .env  |  Copy-Item .env.example .env)
# y completa los valores EN TU MÁQUINA. ".env" está en .gitignore: nunca se sube.
# Este archivo solo contiene NOMBRES de variables, jamás valores reales.
#
# Son las MISMAS variables que la Tarea 1 (el motor de generación se reutiliza de ahí):
# si ya tienes ".env" en "Tarea Septiembre/Tarea 1/", puedes copiar ese mismo archivo aquí.

# Generación (Fase 3) y comparación de embeddings: clave GRATIS de Google AI Studio (https://aistudio.google.com/apikey), sin tarjeta
GEMINI_API_KEY=

# Proveedor alternativo conservado (llm.provider: anthropic), SIN USAR por defecto: requiere plan de pago
ANTHROPIC_API_KEY=

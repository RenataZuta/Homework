# Datos pesados / derivados (se comparten por fuera de git)
data/raw/**
!data/raw/
!data/raw/.gitkeep
data/ocr/*.json

# Modelos entrenados
models/**
!models/**/
!models/**/.gitkeep

# Imágenes y parquet (CVs); las figuras de resultados SÍ se versionan
*.png
*.jpg
*.parquet
!output/figures/*.png

# Python / secretos
__pycache__/
*.pyc
.env
.env.*
!.env.example
.DS_Store

# paquetes para compartir fuera de git
*.zip

# Pesos de modelos en cualquier carpeta (además de models/**) y entorno virtual
*.safetensors
*.bin
*.pt
*.pth
*.joblib
.venv/

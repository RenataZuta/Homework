# ── Secretos: NUNCA versionar. Solo se versiona .env.example (nombres, sin valores) ──
.env
.env.*
!.env.example
.dev.vars
.streamlit/secrets.toml
*.pem
*.key

# ── Entornos y cachés de Python ──
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ── Cachés de modelos (se descargan al usarlos; no se versionan) ──
.cache/
hf_cache/
models_cache/

# ── Sistema operativo ──
.DS_Store
Thumbs.db

# ── Node / Cloudflare Worker ──
node_modules/
.wrangler/

# ── Tarea 1: artefactos regenerables o con datos personales ──
# El índice se reconstruye desde data/processed/ (scripts/build_index.py).
tarea1/data/index_cmp/
tarea1/data/index/*
!tarea1/data/index/.gitkeep
# La base del bot guarda IDs de usuarios de Telegram (dato personal).
*.db
# Caché de respuestas del LLM para la evaluación de punta a punta (regenerable; se invalida sola si cambia el prompt, el contexto o el modelo).
tarea1/eval/cache_llm/

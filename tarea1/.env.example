# Copia este archivo a ".env" (cp .env.example .env  |  Copy-Item .env.example .env)
# y completa los valores EN TU MÁQUINA. ".env" está en .gitignore: nunca se sube.
# Este archivo solo contiene NOMBRES de variables, jamás valores reales.

# Generación (Fases 5, 7, 12)
ANTHROPIC_API_KEY=

# Embeddings por API, solo para la comparación de la Fase 6
OPENAI_API_KEY=

# Bot de Telegram (Fases 10 y 11)
TELEGRAM_BOT_TOKEN=
# IDs numéricos de usuarios autorizados, separados por coma
TELEGRAM_ALLOWED_USER_IDS=
# Secreto que valida el webhook (Worker de Cloudflare)
TELEGRAM_WEBHOOK_SECRET=
# Clave compartida Worker -> backend (header X-Internal-Key)
BACKEND_INTERNAL_KEY=

# Ruta completa a tesseract.exe si no está en el PATH (Fase 2, Windows)
TESSERACT_CMD=
